<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lerguie" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lerguie_night</item>
        <item name="android:statusBarColor">@color/lerguie_night</item>
        <item name="android:navigationBarColor">@color/lerguie_night</item>
    </style>

    <style name="Theme.Lerguie.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lerguie_night</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Lerguie</item>
    </style>
</resources>
